# sdkconfig — Vibra Beam build configuration
# STM32G474RET6

CONFIG_MCU=STM32G474RET6
CONFIG_CPU_FREQ=170000000
CONFIG_FLASH_SIZE=524288
CONFIG_SRAM_SIZE=98304

# ── Laser ───────────────────────────────────────────────
CONFIG_LASER_WAVELENGTH_NM=650
CONFIG_LASER_DEFAULT_MW=1.0
CONFIG_LASER_MAX_MW=5.0
CONFIG_LASER_PWM_HZ=1000

# ── ADC / I-Q sampling ──────────────────────────────────
CONFIG_ADC_SAMPLE_RATE_HZ=2500000
CONFIG_ADC_BLOCK_SAMPLES=512
CONFIG_ADC_OVERSAMPLE=8
CONFIG_ADC_BITS=12

# ── Interferometer / phase ──────────────────────────────
CONFIG_LAMBDA_NM=650
CONFIG_FRANGE_NM=325
CONFIG_UNWRAP_MAX_JUMP_RAD=4.0
CONFIG_BASELINE_TAU_MS=200

# ── Velocity / DSP ──────────────────────────────────────
CONFIG_VEL_LP_FC_DEFAULT_HZ=100000
CONFIG_VEL_LP_FC_MIN_HZ=10
CONFIG_VEL_LP_FC_MAX_HZ=100000
CONFIG_FFT_SIZE_LOG2=12
CONFIG_FFT_SIZE=4096
CONFIG_FFT_WINDOW_HANN=1

# ── IMU ─────────────────────────────────────────────────
CONFIG_IMU_SAMPLE_RATE_HZ=1000
CONFIG_IMU_COMPENSATE_FC_HZ=20
CONFIG_IMU_I2C_ADDR=0x69

# ── Audio ───────────────────────────────────────────────
CONFIG_AUDIO_SAMPLE_RATE_HZ=44100
CONFIG_AUDIO_GAIN_DEFAULT=100
CONFIG_AUDIO_SHIFT_DEFAULT=1.0

# ── Sensors ─────────────────────────────────────────────
CONFIG_DS18B20_GPIO=PC8
CONFIG_BME280_I2C_ADDR=0x76

# ── OLED ────────────────────────────────────────────────
CONFIG_OLED_I2C_ADDR=0x3C
CONFIG_OLED_WIDTH=128
CONFIG_OLED_HEIGHT=64

# ── SD logging ──────────────────────────────────────────
CONFIG_SD_LOG_CSV_HZ=25000
CONFIG_SD_LOG_BIN_HZ=2500000
CONFIG_SD_LOG_CSV=1
CONFIG_SD_LOG_BIN=0

# ── BLE bridge ──────────────────────────────────────────
CONFIG_BLE_UART_BAUD=115200
CONFIG_BLE_MTU=244

# ── Power ───────────────────────────────────────────────
CONFIG_BATTERY_MV_MIN=3300
CONFIG_BATTERY_MV_FULL=4200
CONFIG_BATTERY_MAH=1500

# ── Safety ──────────────────────────────────────────────
CONFIG_SAFETY_TILT_MAX_DEG=45
CONFIG_SAFETY_WATCHDOG_MS=1000