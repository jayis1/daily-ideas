  ;; ═══════════════════════════════════════════════════════════
  ;; NETS / CONNECTIONS
  ;; ═══════════════════════════════════════════════════════════

  (net (name "GND") (code 0))
  (net (name "VCC_3V3") (code 1))
  (net (name "VCC_ANA_3V3") (code 2))
  (net (name "VCC_5V_LASER") (code 3))
  (net (name "VBAT") (code 4))
  (net (name "VBUS_5V") (code 5))

  ;; MCU → ESP32 UART
  (net (name "USART2_TX") (code 10))
  (net (name "USART2_RX") (code 11))

  ;; MCU ADC I/Q
  (net (name "ADC1_IN1_I") (code 20))
  (net (name "ADC2_IN2_Q") (code 21))

  ;; MCU → Laser driver
  (net (name "LASER_PWM") (code 30))
  (net (name "LASER_EN") (code 31))

  ;; MCU → Shutter
  (net (name "SHUTTER_PWM") (code 40))
  (net (name "SHUTTER_EN") (code 41))

  ;; MCU I2C bus
  (net (name "I2C1_SCL") (code 50))
  (net (name "I2C1_SDA") (code 51))

  ;; MCU SPI bus (SD)
  (net (name "SPI2_SCK") (code 60))
  (net (name "SPI2_MISO") (code 61))
  (net (name "SPI2_MOSI") (code 62))
  (net (name "SPI2_NSS") (code 63))

  ;; MCU I2S (audio)
  (net (name "I2S_WS") (code 70))
  (net (name "I2S_BCK") (code 71))
  (net (name "I2S_SD") (code 72))

  ;; GPIO inputs
  (net (name "REED_INTERLOCK") (code 80))
  (net (name "BTN_A") (code 81))
  (net (name "BTN_B") (code 82))
  (net (name "DS18B20_DQ") (code 83))

  ;; Photodiode → TIA
  (net (name "PD1_OUT") (code 90))
  (net (name "PD2_OUT") (code 91))

  ;; TIA → ADC
  (net (name "TIA1_OUT") (code 100))
  (net (name "TIA2_OUT") (code 101))

  ;; ═══════════════════════════════════════════════════════════
  ;; WIRES (summary — full netlist in PCB)
  ;; ═══════════════════════════════════════════════════════════

  (wire (start 55 45) (end 145 45))      ;; MCU ↔ ESP32 UART bus
  (wire (start 55 175) (end 45 225))     ;; PD1 → U7 TIA1 input
  (wire (start 115 175) (end 105 225))  ;; PD2 → U8 TIA2 input
  (wire (start 55 235) (end 45 175))    ;; TIA1_OUT → ADC1_IN1 (PA0)
  (wire (start 115 235) (end 105 175))  ;; TIA2_OUT → ADC2_IN2 (PA1)
  (wire (start 225 45) (end 225 85))    ;; LD1 cathode → U3 driver
  (wire (start 55 415) (end 105 415))   ;; BT1 → MCP73831
  (wire (start 165 415) (end 225 415))  ;; TPS63020 → TPS7A4700
  (wire (start 285 415) (end 345 415))  ;; MT3601 → USB-C VBUS
  (wire (start 55 355) (end 105 355))   ;; DRV8833 → Shutter solenoid
  (wire (start 175 355) (end 45 355))   ;; Reed → MCU PB14

  ;; ── Labels ──
  (label "ADC1_IN1_I" (at 45 175))
  (label "ADC2_IN2_Q" (at 105 175))
  (label "USART2_TX" (at 145 45))
  (label "USART2_RX" (at 55 45))
  (label "I2C1_SCL" (at 145 110))
  (label "I2C1_SDA" (at 145 120))
  (label "SPI2_SCK" (at 55 290))
  (label "LASER_PWM" (at 225 85))
  (label "SHUTTER_EN" (at 55 355))
