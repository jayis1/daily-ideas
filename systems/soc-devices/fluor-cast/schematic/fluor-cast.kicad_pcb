(kicad_pcb
  (version 20240613)
  (generator "fluor-cast-pcb")
  (uuid "00000000-0000-0000-0000-fluorpcb001")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (title_block
    (title "Fluor Cast PCB")
    (date "2026-08-14")
    (rev "1.0")
    (company "SoC Device Inventions")
  )
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user)
    (33 "F.Adhes" user)
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user)
    (37 "F.SilkS" user)
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user)
    (41 "Cmts.User" user)
    (42 "Eco1.User" user)
    (43 "Eco2.User" user)
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user)
    (47 "F.CrtYd" user)
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )
  (setup
    (pad_to_mask_clearance 0.05)
    (pcbplotparams
      (layerselection 0x0001000_7ffffff_ffffffff)
      (plot_on_all_layers_selection 0x0001000_7ffffff_ffffffff)
      (subtractmaskfromsilk yes)
      (outputformat 1)
      (mirror no)
      (drillshape 0)
      (scaleselection 1)
      (outputdirectory "gerbers/")
    )
  )
  (net 0 "")
  (net 1 "+3V3")
  (net 2 "GND")
  (net 3 "+5V")
  (net 4 "+VBAT")
  (net 5 "/LED_PWM")
  (net 6 "/CCD_AO")
  (net 7 "/CCD_SI")
  (net 8 "/CCD_CLK")
  (net 9 "/REF_PD")
  (net 10 "/I2C_SCL")
  (net 11 "/I2C_SDA")
  (net 12 "/SPI_SCK")
  (net 13 "/SPI_MISO")
  (net 14 "/SPI_MOSI")
  (net 15 "/SD_CS")
  (net 16 "/UART_TX")
  (net 17 "/UART_RX")
  (net 18 "/ONEWIRE")

  ;; Board outline: 95mm × 55mm
  (gr_line (start 0 0) (end 95 0) (layer "Edge.Cuts") (width 0.15))
  (gr_line (start 95 0) (end 95 55) (layer "Edge.Cuts") (width 0.15))
  (gr_line (start 95 55) (end 0 55) (layer "Edge.Cuts") (width 0.15))
  (gr_line (start 0 55) (end 0 0) (layer "Edge.Cuts") (width 0.15))

  ;; Mounting holes
  (footprint "MountingHole:MountingHole_2.2mm_M2"
    (at 3 3) (layer "F.Cu") (uuid "hole1"))
  (footprint "MountingHole:MountingHole_2.2mm_M2"
    (at 92 3) (layer "F.Cu") (uuid "hole2"))
  (footprint "MountingHole:MountingHole_2.2mm_M2"
    (at 3 52) (layer "F.Cu") (uuid "hole3"))
  (footprint "MountingHole:MountingHole_2.2mm_M2"
    (at 92 52) (layer "F.Cu") (uuid "hole4"))
)