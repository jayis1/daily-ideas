  ;; ═══════════════════════════════════════════════════════════
  ;; NET CONNECTIONS (key signal paths)
  ;; ═══════════════════════════════════════════════════════════

  ;; STM32 ↔ ESP32-C3 UART bridge
  (net "(PB8 → ESP32 GPIO1 / USART3_RX → UART_TX)")
  (net "(PB9 → ESP32 GPIO2 / USART3_TX → UART_RX)")

  ;; STM32 → CCD (TSL1402R)
  (net "(PA5 → CCD SI / GPIO_Output)")
  (net "(PA6 → CCD CLK / TIM3_CH1_PWM)")
  (net "(PA3 ← CCD AO / ADC2_IN4)")
  (net "(PA4 → CCD reference / DAC1_OUT)")

  ;; STM32 → OPT101 reference photodiode
  (net "(PA1 ← OPT101 Vout / ADC1_IN2)")

  ;; STM32 → LED driver (OPA548)
  (net "(PA0 → OPA548 Vin+ / TIM2_CH1_PWM)")
  (net "(PA7 → OPA548 Enable / GPIO_Output)")

  ;; STM32 → 74HC138 LED select
  (net "(PC0 → 74HC138 A0 / GPIO_Output)")
  (net "(PC1 → 74HC138 A1 / GPIO_Output)")
  (net "(PC2 → 74HC138 A2 / GPIO_Output)")

  ;; STM32 → ULN2003 → 28BYJ-48 stepper
  (net "(PA8 → ULN2003 IN1 → M1 Coil A+)")
  (net "(PA9 → ULN2003 IN2 → M1 Coil B+)")
  (net "(PA10 → ULN2003 IN3 → M1 Coil A-)")
  (net "(PA11 → ULN2003 IN4 → M1 Coil B-)")
  (net "(PA12 ← AH49E Hall sensor / GPIO_Input)")

  ;; STM32 → SPI (SD card + OLED + Flash)
  (net "(PB3 → SPI1_SCK → SD CLK + W25Q CLK)")
  (net "(PB4 ← SPI1_MISO ← SD DAT0 + W25Q DO)")
  (net "(PB5 → SPI1_MOSI → SD CMD + W25Q DI)")
  (net "(PB10 → SD CS / GPIO_Output)")
  (net "(PB11 → OLED CS / GPIO_Output)")
  (net "(PB12 → OLED DC / GPIO_Output)")

  ;; STM32 → I2C (OLED)
  (net "(PB6 → I2C1_SCL → OLED SCL)")
  (net "(PB7 → I2C1_SDA → OLED SDA)")

  ;; STM32 → DS18B20 (1-Wire)
  (net "(PB13 → DS18B20 DQ / GPIO_Output_OD)")

  ;; STM32 → Battery monitoring
  (net "(PC4 ← Battery V / ADC1_IN13)")
  (net "(PC5 ← Battery I / ADC1_IN14)")
  (net "(PC3 ← Charge Status / GPIO_Input)")

  ;; STM32 → Status LEDs
  (net "(PC8 → Status LED Red)")
  (net "(PC9 → Status LED Green)")
  (net "(PC10 → Status LED Blue)")

  ;; STM32 → Safety
  (net "(PB14 ← Lid Interlock / GPIO_Input)")
  (net "(PB15 → HV Safety Enable / GPIO_Output)")

  ;; STM32 → Motor Enable
  (net "(PC11 → Motor Enable / GPIO_Output)")

  ;; STM32 → User Button
  (net "(PC15 ← Button / GPIO_Input_EXTI)")

  ;; Power nets
  (net "+3V3 → STM32 VDD, ESP32 3V3, OLED VCC, SD VCC, DS18B20 VDD, CCD VDD")
  (net "+5V → USB-C, Stepper, LED Driver, OPA548 V+")
  (net "+VBAT → LiPo + → TPS63020 VIN")
  (net "GND → Common ground")

  ;; LED Wheel: 8 LEDs
  (net "LED0: 255nm → 74HC138 Y0")
  (net "LED1: 280nm → 74HC138 Y1")
  (net "LED2: 340nm → 74HC138 Y2")
  (net "LED3: 365nm → 74HC138 Y3")
  (net "LED4: 405nm → 74HC138 Y4")
  (net "LED5: 440nm → 74HC138 Y5")
  (net "LED6: 470nm → 74HC138 Y6")
  (net "LED7: 525nm → 74HC138 Y7")
  (net "LED_PWM: PA0 → OPA548 Vin+ → LED cathode (current sink)")
  (net "REF_PD: OPT101 Vout → PA1 (ADC1_IN2)")
)