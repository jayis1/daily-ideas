# sdkconfig — QCM Halo build configuration
# STM32G474RET6

CONFIG_MCU=STM32G474RET6
CONFIG_CPU_FREQ=170000000
CONFIG_FLASH_SIZE=524288
CONFIG_SRAM_SIZE=98304

# ── QCM-D Parameters ────────────────────────────────────
CONFIG_QCM_FUNDAMENTAL_HZ=5000000
CONFIG_QCM_OVERTONES="1,3,5,7,9,11"
CONFIG_QCM_GATE_TIME_MS=1000
CONFIG_QCM_FREQ_RESOLUTION=0.01
CONFIG_QCM_DISSIPATION_SAMPLES=2048
CONFIG_QCM_DISSIPATION_RATE_HZ=20000000
CONFIG_QCM_CHANNELS=2

# ── Si5351A ─────────────────────────────────────────────
CONFIG_SI5351_I2C_ADDR=0x60
CONFIG_SI5351_XTAL_HZ=25000000
CONFIG_SI5351_LOAD_CAP=10

# ── Temperature ─────────────────────────────────────────
CONFIG_TEC_KP=2.5
CONFIG_TEC_KI=0.8
CONFIG_TEC_KD=0.1
CONFIG_TEC_TEMP_MIN=15.0
CONFIG_TEC_TEMP_MAX=50.0
CONFIG_TEC_TEMP_DEFAULT=25.0
CONFIG_RTD_R_REF=1000.0
CONFIG_RTD_ALPHA=0.003851

# ── Liquid Handling ─────────────────────────────────────
CONFIG_PUMP_RATE_DEFAULT_MLMIN=2.0
CONFIG_PUMP_PWM_HZ=1000
CONFIG_VALVE_STEPS_PER_REV=4096

# ── Storage ─────────────────────────────────────────────
CONFIG_SD_LOG_RATE_HZ=10
CONFIG_SD_LOG_CSV=1
CONFIG_FLASH_PARAMS_ADDR=0x000000

# ── BLE ─────────────────────────────────────────────────
CONFIG_BLE_SERVICE_UUID="6e400001-b5a3-f393-e0a9-e50e24dcca9e"
CONFIG_BLE_TX_UUID="6e400002-b5a3-f393-e0a9-e50e24dcca9e"
CONFIG_BLE_RX_UUID="6e400003-b5a3-f393-e0a9-e50e24dcca9e"
CONFIG_BLE_BAUD=921600

# ── Display ─────────────────────────────────────────────
CONFIG_DISPLAY_I2C_ADDR=0x3C
CONFIG_DISPLAY_WIDTH=128
CONFIG_DISPLAY_HEIGHT=64

# ── Power ───────────────────────────────────────────────
CONFIG_BATTERY_ADC_VREF=3.3
CONFIG_BATTERY_DIVIDER_RATIO=2.0
CONFIG_BATTERY_LOW_MV=3400
CONFIG_BATTERY_CRIT_MV=3200

# ── Debug ───────────────────────────────────────────────
CONFIG_DEBUG_UART_BAUD=115200
CONFIG_DEBUG=1