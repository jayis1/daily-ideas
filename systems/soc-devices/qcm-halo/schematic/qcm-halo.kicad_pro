  "critical_routing": [
    "Si5351A CLK0/CLK1 → ADG918: 50 ohm microstrip, length-matched, <20mm",
    "ADG918 → QCM connector: 50 ohm, minimal via count",
    "OPA656 sense path → ADC: short, shielded, analog plane only",
    "ADS122U04 PT1000 ratiometric: Kelvin sensing, star ground",
    "TEC PWM: wide trace (2mm), separate return path",
    "Crystal 32.768 kHz: guard ring, far from switching signals"
