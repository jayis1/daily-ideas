  ;; ═══════════════════════════════════════════════════════════
  ;; NET CONNECTIONS
  ;; ═══════════════════════════════════════════════════════════

  ;; Si5351A → I2C bus
  (net (code 1) (name "I2C1_SCL") (pts (xy 220 45) (xy 50 65)))
  (net (code 2) (name "I2C1_SDA") (pts (xy 220 50) (xy 50 70)))

  ;; Si5351A CLK0 → ADG918 U6 (TX/RX switch CH1)
  (net (code 3) (name "CLK0_DRIVE") (pts (xy 220 55) (xy 180 115)))

  ;; Si5351A CLK1 → ADG918 U7 (TX/RX switch CH2)
  (net (code 4) (name "CLK1_DRIVE") (pts (xy 220 60) (xy 240 115)))

  ;; ADG918 U6 → QCM CH1 crystal (J2)
  (net (code 5) (name "QCM1_DRIVE") (pts (xy 180 120) (xy 300 415)))
  ;; ADG918 U6 ← QCM CH1 crystal (sense) → OPA656 U8
  (net (code 6) (name "QCM1_SENSE") (pts (xy 180 125) (xy 50 175)))
  (net (code 7) (name "QCM1_AMP") (pts (xy 50 180) (xy 50 45)))

  ;; ADG918 U7 → QCM CH2 crystal (J3)
  (net (code 8) (name "QCM2_DRIVE") (pts (xy 240 120) (xy 360 415)))
  (net (code 9) (name "QCM2_SENSE") (pts (xy 240 125) (xy 120 175)))
  (net (code 10) (name "QCM2_AMP") (pts (xy 120 180) (xy 50 50)))

  ;; OPA656 U8/U9 outputs → STM32 ADC1_IN1 (ring-down) + LTC1968 (dissipation)
  (net (code 11) (name "ADC_RING_DOWN") (pts (xy 50 185) (xy 50 45)))
  (net (code 12) (name "DISSIPATION_RF") (pts (xy 120 185) (xy 120 115)))

  ;; LTC1968 → STM32 ADC1_IN2 (RMS DC output)
  (net (code 13) (name "DISSIPATION_DC") (pts (xy 120 120) (xy 50 50)))

  ;; ADS122U04 ↔ STM32 SPI
  (net (code 14) (name "ADS122_CS") (pts (xy 50 115) (xy 50 55)))
  (net (code 15) (name "ADS122_SCK") (pts (xy 50 120) (xy 50 60)))
  (net (code 16) (name "ADS122_MISO") (pts (xy 50 125) (xy 50 65)))
  (net (code 17) (name "ADS122_DRDY") (pts (xy 50 130) (xy 50 70)))

  ;; PT1000 → ADS122U04 (ratiometric 4-wire)
  (net (code 18) (name "PT1000_EXC_P") (pts (xy 170 235) (xy 50 135)))
  (net (code 19) (name "PT1000_EXC_N") (pts (xy 170 240) (xy 50 140)))
  (net (code 20) (name "PT1000_SENSE_P") (pts (xy 170 245) (xy 50 145)))
  (net (code 21) (name "PT1000_SENSE_N") (pts (xy 170 250) (xy 50 150)))

  ;; DS18B20 1-Wire → STM32 PC13
  (net (code 22) (name "ONEWIRE") (pts (xy 50 235) (xy 50 75)))

  ;; BME280 → I2C bus
  (net (code 23) (name "BME280_SCL") (pts (xy 110 235) (xy 220 45)))
  (net (code 24) (name "BME280_SDA") (pts (xy 110 240) (xy 220 50)))

  ;; STM32 ↔ ESP32-C3 UART
  (net (code 25) (name "UART_TX") (pts (xy 50 80) (xy 150 45)))
  (net (code 26) (name "UART_RX") (pts (xy 50 85) (xy 150 50)))

  ;; STM32 TIM1 → TX/RX switch gates
  (net (code 27) (name "TX_GATE") (pts (xy 50 90) (xy 180 110)))
  (net (code 28) (name "RX_GATE") (pts (xy 50 95) (xy 240 110)))

  ;; Crystal select
  (net (code 29) (name "CH1_SEL") (pts (xy 50 100) (xy 180 105)))
  (net (code 30) (name "CH2_SEL") (pts (xy 50 105) (xy 240 105)))

  ;; Peltier PWM + enable
  (net (code 31) (name "TEC_PWM") (pts (xy 50 115) (xy 50 295)))
  (net (code 32) (name "TEC_ENABLE") (pts (xy 50 120) (xy 110 295)))

  ;; MT3601 → TEC power
  (net (code 33) (name "TEC_12V") (pts (xy 110 300) (xy 50 300)))

  ;; DRV8833 → Peristaltic pump
  (net (code 34) (name "PUMP_PWM") (pts (xy 180 295) (xy 50 125)))
  (net (code 35) (name "PUMP_OUT_A") (pts (xy 180 300) (xy 180 470)))
  (net (code 36) (name "PUMP_OUT_B") (pts (xy 180 305) (xy 190 470)))

  ;; ULN2003 → 28BYJ-48 (valve)
  (net (code 37) (name "VALVE_A") (pts (xy 250 295) (xy 50 130)))
  (net (code 38) (name "VALVE_B") (pts (xy 250 300) (xy 50 135)))
  (net (code 39) (name "VALVE_C") (pts (xy 250 305) (xy 50 140)))
  (net (code 40) (name "VALVE_D") (pts (xy 250 310) (xy 50 145)))

  ;; Power nets
  (net (code 41) (name "VBUS_5V") (pts (xy 50 475) (xy 180 355)))
  (net (code 42) (name "VBAT") (pts (xy 140 475) (xy 240 355)))
  (net (code 43) (name "+3V3_DIG") (pts (xy 240 360) (xy 50 40)))
  (net (code 44) (name "+3V3_ANA") (pts (xy 300 355) (xy 50 175)))
  (net (code 45) (name "GND") (pts (xy 50 475) (xy 300 470)))

  ;; SPI bus (SD card + W25Q128)
  (net (code 46) (name "SPI1_SCK") (pts (xy 50 55) (xy 140 415) (xy 220 415)))
  (net (code 47) (name "SPI1_MISO") (pts (xy 50 60) (xy 140 420) (xy 220 420)))
  (net (code 48) (name "SPI1_MOSI") (pts (xy 50 65) (xy 140 425) (xy 220 425)))
  (net (code 49) (name "FLASH_CS") (pts (xy 50 70) (xy 140 430)))
  (net (code 50) (name "SD_CS") (pts (xy 50 75) (xy 220 430)))

  ;; ADC battery monitor
  (net (code 51) (name "VBAT_SENSE") (pts (xy 140 475) (xy 50 110)))

  ;; Buttons
  (net (code 52) (name "BTN_A") (pts (xy 50 120) (xy 30 120)))
  (net (code 53) (name "BTN_B") (pts (xy 50 125) (xy 30 125)))

  ;; Status LED
  (net (code 54) (name "LED_R") (pts (xy 50 130) (xy 30 130)))
  (net (code 55) (name "LED_G") (pts (xy 50 135) (xy 30 135)))
  (net (code 56) (name "LED_B") (pts (xy 50 140) (xy 30 140)))

  ;; Ring-down trigger
  (net (code 57) (name "RINGDOWN_TRIG") (pts (xy 50 145) (xy 180 130)))

  ;; Reciprocal counting input (TIM2_CH1 from OPA656 squared)
  (net (code 58) (name "FREQ_COUNT") (pts (xy 50 185) (xy 50 90)))

  ;; IWDG + reed interlock
  (net (code 59) (name "REED_INTERLOCK") (pts (xy 50 150) (xy 30 150)))

  ;; ═══════════════════════════════════════════════════════════
  ;; POWER ANNOTATIONS
  ;; ═══════════════════════════════════════════════════════════
  (label "VBUS_5V" (at 55 475))
  (label "VBAT" (at 145 475))
  (label "+3V3_DIG" (at 245 360))
  (label "+3V3_ANA" (at 305 355))
  (label "GND" (at 55 470))

  (text "QCM Halo — Pocket QCM-D Instrument"
    (at 100 20) (size 3))
  (text "Si5351A generates drive signal → ADG918 TX/RX switch → QCM crystal"
    (at 100 25) (size 1.5))
  (text "Ring-down: TX off → ADC captures decay envelope → exp fit → D"
    (at 100 30) (size 1.5))
  (text "Frequency: reciprocal counting via TIM2 gated by 1s timebase"
    (at 100 35) (size 1.5))
)