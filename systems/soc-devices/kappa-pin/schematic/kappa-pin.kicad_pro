(kicad_pro
  (version "1.0")
  (meta (filename "kappa-pin.kicad_pro"))
  (general
    (project_name "Kappa Pin")
    (project_version "1.0"))
  (board
    (layer_setup
      (layers
        (0 "F.Cu" signal)
        (1 "B.Cu" signal)
        (2 "F.SilkS" user)
        (3 "B.SilkS" user)
        (4 "F.Mask" user)
        (5 "B.Mask" user)
        (6 "Edge.Cuts" user)))
    (setup
      (trace_min_width 0.15)
      (via_min_size 0.3)
      (via_min_drill 0.2)))
  (schematic
    (default_line_width 0.15)
    (default_text_size 1.27))
  (erc
    (rule "no_unconnected"))
  (drc
    (rule "min_clearance" 0.15))
  (libraries
    (lib (name "Analog_ADC") (type "kicad_sym"))
    (lib (name "Amplifier_Operational") (type "kicad_sym"))
    (lib (name "RF_Module") (type "kicad_sym"))
    (lib (name "Display") (type "kicad_sym"))
    (lib (name "Connector") (type "kicad_sym"))
    (lib (name "Device") (type "kicad_sym"))
    (lib (name "Sensor") (type "kicad_sym"))
    (lib (name "Transistor_FET") (type "kicad_sym"))
    (lib (name "Potentiometer_Digital") (type "kicad_sym"))
    (lib (name "Battery_Management") (type "kicad_sym"))
    (lib (name "Regulator_Linear") (type "kicad_sym"))
    (lib (name "Switch") (type "kicad_sym")))
  (copyright "MIT License"))