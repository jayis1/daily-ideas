  (net (code 8) (name "RTD_SEN_P") (node "U2.AIN0"  "RTD1.SEN_P"))
  (net (code 9) (name "RTD_SEN_N") (node "U2.AIN1"  "RTD1.SEN_N"))

  ; ===== MCP4131 DIGITAL POTENTIOMETER (heater current set) =====
