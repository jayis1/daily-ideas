(kicad_sch
  (version 20231120)
  (generator "hermes-inventor")
  (paper "A3")
  (title_block
    (title "Kappa Pin — Pocket Thermal Conductivity & Diffusivity Meter")
    (date "2026-07-27")
    (company "SoC Device Inventions")
    (comment 1 "ESP32-S3-WROOM-1")
    (comment 2 "ADS122U04 24-bit ADC + PT1000 4-wire RTD")
    (comment 3 "MCP4131 + OPA548 constant-power heater driver")
    (comment 4 "ASTM D5334 / D7896 transient line-source method — MIT License"))

  ; ===== POWER SECTION =====
  (symbol (lib_id "power:VBAT") (at 50 40) (fields_autoplaced)
