(kicad_sch
  (version 20231120)
  (generator "hermes-inventor")
  (paper "A3")
  (title_block
    (title "Visco Shear — Pocket Rotational Rheometer & Viscometer")
    (date "2026-07-31")
    (company "SoC Device Inventions")
    (comment 1 "RP2040 + ESP32-C3")
    (comment 2 "ADS1115 16-bit ADC + DRV5053 Hall torque sensor")
    (comment 3 "TMC2209 1/256 microstep + NEMA8 stepper")
    (comment 4 "Peltier TEC1-12706 temperature control — MIT License"))

  ; ===== POWER SECTION =====
  (symbol (lib_id "power:VBAT") (at 50 40) (fields_autoplaced)
    (property "Value" "VBAT3V7") (at 50 34 0))
  (symbol (lib_id "Device:C") (at 70 45 0)
    (property "Value" "22uF") (at 70 45 0))
  (symbol (lib_id "Regulator_Switching:TPS63020") (at 110 50 0)
    (property "Reference" "U7") (at 110 50 0)
    (property "Value" "TPS63020") (at 110 42 0))
  (symbol (lib_id "Device:L") (at 90 40 0)
    (property "Value" "2.2uH") (at 90 40 0))
  (symbol (lib_id "Device:C") (at 150 45 0)
    (property "Value" "22uF") (at 150 45 0))
  (symbol (lib_id "power:+3V3") (at 160 40 0))
  (symbol (lib_id "Regulator_Linear:TLV70033") (at 200 50 0)
    (property "Reference" "U8") (at 200 50 0)
    (property "Value" "TLV70033") (at 200 42 0))
  (symbol (lib_id "power:+3V3_SENS") (at 250 40 0))
  (symbol (lib_id "power:GND") (at 50 110 0))

  ; ===== USB-C CHARGE =====
  (symbol (lib_id "Connector:USB_C_Plug") (at 40 140 0)
    (property "Reference" "J1") (at 40 140 0)
    (property "Value" "USB-C 5V") (at 40 132 0))
  (symbol (lib_id "Battery_Management:MCP73831") (at 100 145 0)
    (property "Reference" "U9") (at 100 145 0)
    (property "Value" "MCP73831") (at 100 138 0))
  (symbol (lib_id "Battery_Protection:DW01A") (at 160 145 0)
    (property "Reference" "U10") (at 160 145 0)
    (property "Value" "DW01A") (at 160 138 0))
  (symbol (lib_id "Transistor_FET:FS8205A") (at 210 145 0)
    (property "Reference" "U11") (at 210 145 0)
    (property "Value" "FS8205A") (at 210 138 0))
  (symbol (lib_id "Connector:Conn_01x02") (at 50 170 0)
    (property "Reference" "J2") (at 50 170 0)
    (property "Value" "JST-PH 2-pin Battery") (at 50 162 0))

  ; ===== RP2040 =====
  (symbol (lib_id "MCU_RaspberryPi:RP2040") (at 220 250 0)
    (property "Reference" "U1") (at 220 250 0)
    (property "Value" "RP2040") (at 220 180 0))
  (symbol (lib_id "Memory_Flash:W25Q16JV") (at 330 210 0)
    (property "Reference" "U2") (at 330 210 0)
    (property "Value" "W25Q16JVSN") (at 330 200 0))
  (symbol (lib_id "Device:Crystal") (at 170 320 0)
    (property "Value" "12MHz") (at 170 320 0))
  (symbol (lib_id "Device:C") (at 150 310 0)
    (property "Value" "22pF") (at 150 310 0))
  (symbol (lib_id "Device:C") (at 150 330 0)
    (property "Value" "22pF") (at 150 330 0))

  ; ===== ESP32-C3 (BLE/Wi-Fi companion) =====
  (symbol (lib_id "RF_Module:ESP32-C3-WROOM-02") (at 440 250 0)
    (property "Reference" "U3") (at 440 250 0)
    (property "Value" "ESP32-C3-WROOM-02") (at 440 200 0))
  (net (code 1) (name "UART_TX_RP")  (node "U1.GPIO18" "U3.GPIO2"))
  (net (code 2) (name "UART_RX_RP")  (node "U1.GPIO19" "U3.GPIO3"))
  (net (code 3) (name "ESP32_USB_DN") (node "J1.D-" "U3.GPIO8"))
  (net (code 4) (name "ESP32_USB_DP") (node "J1.D+" "U3.GPIO9"))
  (net (code 5) (name "ESP32_LED")   (node "U3.GPIO5" "LED2.A"))

  ; ===== TMC2209 STEPPER DRIVER =====
  (symbol (lib_id "Driver_Motor:TMC2209") (at 110 380 0)
    (property "Reference" "U5") (at 110 380 0)
    (property "Value" "TMC2209") (at 110 350 0))
  (symbol (lib_id "Motor:Stepper_Motor_bipolar") (at 200 390 0)
    (property "Reference" "MOT1") (at 200 390 0)
    (property "Value" "NEMA8 20mm") (at 200 380 0))
  (net (code 6)  (name "STEP")    (node "U5.STEP"   "U1.GPIO0"))
  (net (code 7)  (name "DIR")     (node "U5.DIR"    "U1.GPIO1"))
  (net (code 8)  (name "TMC_EN")  (node "U5.EN"     "U1.GPIO2"))
  (net (code 9)  (name "TMC_UART") (node "U5.UART"  "U1.GPIO3"))
  (net (code 10) (name "TMC_FAULT") (node "U5.DIAG" "U1.GPIO22"))
  (net (code 11) (name "MOT_A1")  (node "U5.A1"  "MOT1.A1"))
  (net (code 12) (name "MOT_A2")  (node "U5.A2"  "MOT1.A2"))
  (net (code 13) (name "MOT_B1")  (node "U5.B1"  "MOT1.B1"))
  (net (code 14) (name "MOT_B2")  (node "U5.B2"  "MOT1.B2"))

  ; ===== ADS1115 16-bit ADC (I2C) — Hall torque sensor =====
  (symbol (lib_id "Analog_ADC:ADS1115") (at 110 470 0)
    (property "Reference" "U4") (at 110 470 0)
    (property "Value" "ADS1115IDGS") (at 110 445 0))
  (symbol (lib_id "Sensor:DRV5053") (at 40 480 0)
    (property "Reference" "U12") (at 40 480 0)
    (property "Value" "DRV5053 (torque)") (at 40 470 0))
  (symbol (lib_id "Sensor:DRV5053") (at 40 530 0)
    (property "Reference" "U13") (at 40 530 0)
    (property "Value" "DRV5053 (reference)") (at 40 520 0))
  (net (code 15) (name "I2C_SCL") (node "U4.SCL" "U1.GPIO4" "U14.SCL"))
  (net (code 16) (name "I2C_SDA") (node "U4.SDA" "U1.GPIO5" "U14.SDA"))
  (net (code 17) (name "HALL_TORQUE")  (node "U12.OUT" "U4.AIN0"))
  (net (code 18) (name "HALL_REF")     (node "U13.OUT" "U4.AIN1"))
  (net (code 19) (name "HALL_VREF_DRV") (node "U12.VCC" "U13.VCC" "+3V3_SENS"))
  (net (code 20) (name "ADS_ADDR_GND") (node "U4.ADR"  "GND"))

  ; ===== DRV8833 H-BRIDGE (Peltier driver) =====
  (symbol (lib_id "Driver_Motor:DRV8833") (at 320 380 0)
    (property "Reference" "U6") (at 320 380 0)
    (property "Value" "DRV8833PW") (at 320 350 0))
  (symbol (lib_id "Sensor_Temperature:Thermistor_NTC") (at 440 380 0)
    (property "Reference" "NTC1") (at 440 380 0)
    (property "Value" "10kΩ B3950") (at 440 370 0))
  (symbol (lib_id "Device:R") (at 440 400 0)
    (property "Value" "10kΩ") (at 440 400 0)
    (property "Reference" "R_NTC_DIV"))
  (net (code 21) (name "PELTIER_PWM")  (node "U6.AIN1" "U1.GPIO7"))
  (net (code 22) (name "PELTIER_DIR")  (node "U6.AIN2" "U1.GPIO8"))
  (net (code 23) (name "PELTIER_EN")   (node "U6.EN"   "U1.GPIO9"))
  (net (code 24) (name "PELT_AOUT1")   (node "U6.AOUT1" "TEC1.A"))
  (net (code 25) (name "PELT_AOUT2")   (node "U6.AOUT2" "TEC1.B"))
  (net (code 26) (name "NTC_SENSE")    (node "NTC1.1" "R_NTC_DIV.1" "U1.GPIO27"))
  (net (code 27) (name "NTC_GND")      (node "R_NTC_DIV.2" "GND"))
  (symbol (lib_id "power:VBAT") (at 470 380 0)
    (property "Value" "VBAT3V7") (at 470 374 0))

  ; ===== SH1106 OLED (I2C) =====
  (symbol (lib_id "Display:SH1106_128x64_I2C") (at 560 250 0)
    (property "Reference" "U14") (at 560 250 0)
    (property "Value" "SH1106 1.3in") (at 560 220 0))

  ; ===== MICROSD (SPI) =====
  (symbol (lib_id "Connector:MicroSD") (at 560 380 0)
    (property "Reference" "J4") (at 560 380 0)
    (property "Value" "MicroSD") (at 560 350 0))
  (net (code 28) (name "SD_CS")   (node "J4.CS"   "U1.GPIO10"))
  (net (code 29) (name "SPI_SCK") (node "J4.SCK"  "U1.GPIO11"))
  (net (code 30) (name "SPI_MISO") (node "J4.MISO" "U1.GPIO12"))
  (net (code 31) (name "SPI_MOSI") (node "J4.MOSI" "U1.GPIO13"))

  ; ===== BUTTONS + BUZZER + LEDs =====
  (symbol (lib_id "Switch:SW_Push") (at 560 460 0)
    (property "Reference" "S1") (at 560 460 0)
    (property "Value" "START") (at 560 450 0))
  (symbol (lib_id "Switch:SW_Push") (at 620 460 0)
    (property "Reference" "S2") (at 620 460 0)
    (property "Value" "MODE") (at 620 450 0))
  (symbol (lib_id "Switch:SW_Push") (at 680 460 0)
    (property "Reference" "S3") (at 680 460 0)
    (property "Value" "MENU") (at 680 450 0))
  (symbol (lib_id "Device:Buzzer") (at 560 510 0)
    (property "Reference" "BUZ1") (at 560 510 0)
    (property "Value" "Piezo 5V") (at 560 500 0))
  (symbol (lib_id "Device:LED") (at 620 510 0)
    (property "Reference" "LED1") (at 620 510 0)
    (property "Value" "White") (at 620 500 0))
  (symbol (lib_id "Device:LED") (at 680 510 0)
    (property "Reference" "LED2") (at 680 510 0)
    (property "Value" "Blue") (at 680 500 0))
  (net (code 32) (name "BTN_START") (node "S1.1" "U1.GPIO14"))
  (net (code 33) (name "BTN_MODE")  (node "S2.1" "U1.GPIO15"))
  (net (code 34) (name "BTN_MENU")  (node "S3.1" "U1.GPIO16"))
  (net (code 35) (name "BUZZER")    (node "BUZ1.1" "U1.GPIO17"))
  (net (code 36) (name "STATUS_LED") (node "LED1.A" "U1.GPIO20"))
  (net (code 37) (name "BLE_LED")    (node "LED2.A" "U3.GPIO5"))

  ; ===== SPINDLE DETECT (ADC) =====
  (symbol (lib_id "Device:R") (at 40 580 0)
    (property "Value" "10kΩ") (at 40 580 0)
    (property "Reference" "R_SPINDLE_DIV"))
  (net (code 38) (name "SPINDLE_ID") (node "J5.ID" "R_SPINDLE_DIV.1" "U1.GPIO21"))
  (net (code 39) (name "SPINDLE_VCC") (node "R_SPINDLE_DIV.2" "+3V3"))

  ; ===== SPINDLE QUICK-CHANGE CONNECTOR =====
  (symbol (lib_id "Connector:Conn_01x04") (at 40 410 0)
    (property "Reference" "J5") (at 40 410 0)
    (property "Value" "Spindle coupling") (at 40 400 0))

  ; ===== ROTARY ENCODER =====
  (symbol (lib_id "Device:RotaryEncoder") (at 740 460 0)
    (property "Reference" "ENC1") (at 740 460 0)
    (property "Value" "EC11E-S") (at 740 450 0))
  (net (code 40) (name "ENC_A") (node "ENC1.A" "U1.GPIO21"))
  (net (code 41) (name "ENC_B") (node "ENC1.B" "U1.GPIO22"))

  ; ===== SWD HEADER =====
  (symbol (lib_id "Connector:Conn_01x06") (at 740 250 0)
    (property "Reference" "J3") (at 740 250 0)
    (property "Value" "SWD 6-pin") (at 740 240 0))
  (net (code 42) (name "SWD_CLK") (node "J3.2" "U1.SWD_CLK"))
  (net (code 43) (name "SWD_IO")  (node "J3.3" "U1.SWD_IO"))
  (net (code 44) (name "SWD_GND") (node "J3.4" "GND"))

  ; ===== BATTERY VOLTAGE MONITOR =====
  (symbol (lib_id "Device:R") (at 50 600 0)
    (property "Value" "100kΩ") (at 50 600 0)
    (property "Reference" "R_VBAT_HI"))
  (symbol (lib_id "Device:R") (at 80 600 0)
    (property "Value" "100kΩ") (at 80 600 0)
    (property "Reference" "R_VBAT_LO"))
  (net (code 45) (name "VBAT_MON") (node "R_VBAT_HI.2" "R_VBAT_LO.1" "U1.GPIO28"))
  (net (code 46) (name "VBAT_DIV_GND") (node "R_VBAT_LO.2" "GND"))
)